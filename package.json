{
  "name": "datas-world",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:determinism": "vitest run --passWithNoTests -t determinismo",
    "guardrails": "node scripts/guardrails/check.mjs",
    "cli": "node apps/cli/src/main.ts",
    "worker": "node apps/worker/src/main.ts",
    "bench": "node apps/cli/src/main.ts bench",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm guardrails",
    "api": "node apps/api/src/main.ts",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
