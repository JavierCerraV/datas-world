      "attrs": {"stage": "adolescencia", "weight": 1.5, "speaker": "par", "valence": 0, "text": "Contó algo personal y se burlaron de eso.", "effects": [{"op": "operant", "response": "conv.abrirse", "outcome": 0.1}, {"op": "pair", "stim": "verbal.confidencia", "lambda": -0.4, "us": "verbal.burla", "social": true}], "status": "estimado"}
    },
